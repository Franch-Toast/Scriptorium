{
  "name": "scriptorium",
  "version": "0.1.0",
  "private": true,
  "description": "Scriptorium — 个人文档知识库站点（VitePress + vitepress-theme-teek），Hub-and-Spoke 架构中的唯一内容源仓库",
  "type": "module",
  "scripts": {
    "dev": "pnpm docs:frontmatter --check && node scripts/gen-contributions.mjs && vitepress dev .",
    "prebuild": "pnpm docs:frontmatter --check && node scripts/gen-contributions.mjs",
    "build": "vitepress build .",
    "preview": "vitepress preview .",
    "gen:contributions": "node scripts/gen-contributions.mjs",
    "docs:frontmatter": "node scripts/docs-frontmatter.mjs"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "mermaid": "^11.17.2",
    "sass": "^1.104.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitepress-plugin-permalink": "^1.2.1",
    "vitepress-sidebar": "^1.40.0",
    "vitepress-theme-teek": "^1.6.2",
    "vue": "^3.5.43"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ]
  }
}
